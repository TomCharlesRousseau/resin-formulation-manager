# Copy this file to secrets.toml (same folder) for local development.
#
# For Streamlit Community Cloud, don't create a file at all — instead paste these same
# keys into your app's Settings -> Secrets panel when you deploy. Either way, this only
# needs to be set up once per deployment, and it never gets committed to git.
#
# Both keys are optional. Leaving them unset (or leaving this file uncopied) is fine —
# the app just starts with a blank OpenBIS URL / space, and the user fills them in
# from the Connection / General Information tabs instead.

openbis_url = "https://your-openbis-instance.example.com"
default_space = "YOUR_SPACE_CODE"
